---
type Props = {
  quote: string;
  author: string;
  title: string;
};

const { quote, author, title } = Astro.props;
---

<div class="flex">
  <blockquote
    class="flex w-full flex-col rounded-md border-l-4 border-slate-300 bg-slate-50 px-6 py-8 text-lg text-slate-600 italic"
  >
    “{quote}”

    <footer class="mt-auto pt-4 text-sm font-semibold text-slate-500">
      — {author}
      <br />
      <span class="font-normal">
        {title}
      </span>
    </footer>
  </blockquote>
</div>
