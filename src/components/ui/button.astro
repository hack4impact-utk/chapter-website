---
type Props = {
  href: string;
  text: string;
  variant: "primary" | "secondary";
};

const { href, text, variant } = Astro.props;
---

<a
  href={href}
  class=`inline-flex items-center justify-center rounded-md px-6 py-3 font-semibold transition-colors \
  ${variant === "primary" ? "bg-primary text-white hover:bg-primary/80" : "bg-white  hover:bg-slate-100 border border-slate-300"}
  `
>
  {text}
</a>
